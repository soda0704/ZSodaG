shader_parameter/snow_normal = ExtResource("6_a3ffr")
shader_parameter/ice_color = ExtResource("7_b61jw")
shader_parameter/ice_normal = ExtResource("8_c2okt")
shader_parameter/ice_roughness = ExtResource("9_23ye3")
shader_parameter/rock_mode = true

