[gd_scene format=3]
[ext_resource type="Theme" path="res://scenes/ui/menu_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/character_skin_selection.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/ui/character_choice.tscn" id="choice"]

[node name="SkinCard" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="SelectionShade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0.66)

[node name="LeftCharacter" parent="." instance=ExtResource("choice")]
layout_mode = 1
anchor_right = 0.5
anchor_bottom = 1.0
focus_neighbor_right = NodePath("../RightCharacter")
focus_next = NodePath("../RightCharacter")
focus_previous = NodePath("../RightCharacter")

[node name="RightCharacter" parent="." instance=ExtResource("choice")]
layout_mode = 1
anchor_left = 0.5
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
focus_neighbor_left = NodePath("../LeftCharacter")
focus_next = NodePath("../LeftCharacter")
focus_previous = NodePath("../LeftCharacter")

[node name="Heading" type="Label" parent="."]
layout_mode = 0
offset_left = 88.0
offset_top = 112.0
offset_right = 1100.0
offset_bottom = 185.0
theme_type_variation = &"MenuTitle"
theme_override_font_sizes/font_size = 48
text = "ВЫБЕРИТЕ ПЕРСОНАЖА"
mouse_filter = 2
[node name="Caption" type="Label" parent="."]
visible = false
layout_mode = 0
offset_left = 88.0
offset_top = 190.0
offset_right = 1100.0
offset_bottom = 225.0
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.72, 0.72, 0.72, 1)
text = "Нажмите на персонажа, чтобы продолжить."
mouse_filter = 2
