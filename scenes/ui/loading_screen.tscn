[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/loading_screen.gd" id="logic"]

[ext_resource type="Script" path="res://scripts/ui/loading_tip.gd" id="tip"]

[ext_resource type="Theme" path="res://scenes/ui/northern_lab_hud_theme.tres" id="theme"]

[ext_resource type="Material" path="res://assets/ui/menu_fog.tres" id="fog"]

[ext_resource type="AudioStream" path="res://assets/audio/music/loading_northernlab.ogg" id="music"]

[ext_resource type="Texture2D" path="res://assets/ui/branding/releases/northernlab-logo-v1/northernlab-512.png" id="logo"]

[ext_resource type="Shader" path="res://assets/shaders/loading_pill.gdshader" id="pill_shader"]

[sub_resource type="ShaderMaterial" id="pill_material"]
resource_local_to_scene = true
shader = ExtResource("pill_shader")
shader_parameter/track_color = Color(0.09, 0.15, 0.18, 0.65)
shader_parameter/track_border_color = Color(0.4, 0.65, 0.72, 0.24)
shader_parameter/color_min = Color(0.32, 0.56, 0.65, 1)
shader_parameter/color_max = Color(0.75, 0.9, 0.94, 1)
shader_parameter/fill_ratio = 0.0
shader_parameter/corner_radius = 0.5
shader_parameter/border_width = 0.04
shader_parameter/edge_softness = 0.0005
shader_parameter/handle_radius = 0.0
shader_parameter/handle_outline_width = 0.02
shader_parameter/handle_shadow_strength = 0.0
shader_parameter/tip_glow_strength = 0.04
shader_parameter/tip_glow_width = 0.018
shader_parameter/tip_pulse_speed = 0.8

[sub_resource type="Resource" id="tip0"]
script = ExtResource("tip")
title = "Прислушивайся."
body = "Бег и выстрелы привлекают внимание. Пригнувшись, можно остаться незамеченным чуть дольше."

[sub_resource type="Resource" id="tip1"]
script = ExtResource("tip")
title = "Свет не бесконечен."
body = "Берегите заряд — неизвестно, сколько ещё находиться в темноте."

[sub_resource type="Resource" id="tip2"]
script = ExtResource("tip")
title = "Делитесь с напарником."
body = "Удерживайте {offer_item}, чтобы протянуть предмет."

[sub_resource type="Resource" id="tip3"]
script = ExtResource("tip")
title = "Вдвоём легче."
body = "Удерживайте {interact}, чтобы тащить предмет. С напарником его можно приподнять."

[sub_resource type="Resource" id="tip4"]
script = ExtResource("tip")
title = "Журнал экспедиции."
body = "Задачи, найденные записи и ваши вещи — в журнале. Просмотреть — {journal}."

[sub_resource type="Resource" id="tip5"]
script = ExtResource("tip")
title = "Жизнь на базе."
body = "Не забывайте поливать растение"

[sub_resource type="Gradient" id="gradient"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.008, 0.01, 0.011, 0.04, 0.008, 0.01, 0.011, 0.38, 0.008, 0.01, 0.011, 0.98)

[sub_resource type="GradientTexture2D" id="shade"]
gradient = SubResource("gradient")
width = 8
height = 512
fill_from = Vector2(0, 0)
fill_to = Vector2(0, 1)

[node name="LoadingScreen" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
process_mode = 3
theme = ExtResource("theme")
script = ExtResource("logic")
tips = Array[ExtResource("tip")]([SubResource("tip0"), SubResource("tip1"), SubResource("tip2"), SubResource("tip3"), SubResource("tip4"), SubResource("tip5")])

[node name="SmokeBackground" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
material = ExtResource("fog")

[node name="Shade" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = SubResource("shade")
expand_mode = 1

[node name="Footer" type="MarginContainer" parent="."]
layout_mode = 0
anchor_top = 1.0
anchor_bottom = 1.0
offset_top = -270.0
offset_right = 1920.0
mouse_filter = 2
theme_override_constants/margin_left = 56
theme_override_constants/margin_right = 56
theme_override_constants/margin_bottom = 36

[node name="Content" type="VBoxContainer" parent="Footer"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Status" type="HBoxContainer" parent="Footer/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 14

[node name="Logo" type="TextureRect" parent="Footer/Content/Status"]
layout_mode = 2
custom_minimum_size = Vector2(62, 62)
mouse_filter = 2
texture = ExtResource("logo")
expand_mode = 1
stretch_mode = 5

[node name="TransitionLabel" type="Label" parent="Footer/Content/Status"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"HudHeading"
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.65, 0.82, 0.88, 1)
text = "ПОСАДКА У БАЗЫ…"

[node name="LoadingProgress" type="ColorRect" parent="Footer/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 4)
mouse_filter = 2
material = SubResource("pill_material")

[node name="TipTitle" type="Label" parent="Footer/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Прислушивайся."

[node name="TipBody" type="Label" parent="Footer/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
custom_minimum_size = Vector2(0, 60)
theme_override_font_sizes/font_size = 22
autowrap_mode = 2
text = "Бег и выстрелы привлекают внимание."

[node name="Music" type="AudioStreamPlayer" parent="."]
stream = ExtResource("music")
bus = &"Music"
volume_db = -80.0

