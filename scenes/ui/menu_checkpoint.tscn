[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/menu_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/ui/menu_button.gd" id="button"]

[node name="CheckpointPage" type="VBoxContainer"]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("theme")
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MenuTitle"
theme_override_font_sizes/font_size = 33
text = "ЭКСПЕДИЦИИ"

[node name="Mode" type="Label" parent="."]
layout_mode = 2
text = "Одиночная игра"

[node name="Slots" type="OptionButton" parent="."]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 0

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Naming" type="HBoxContainer" parent="Scroll/Body"]
layout_mode = 2

[node name="Name" type="LineEdit" parent="Scroll/Body/Naming"]
custom_minimum_size = Vector2(320, 42)
layout_mode = 2
max_length = 48
placeholder_text = "Название экспедиции"

[node name="Rename" type="Button" parent="Scroll/Body/Naming"]
layout_mode = 2
text = "ПЕРЕИМЕНОВАТЬ"
script = ExtResource("button")

[node name="Day" type="Label" parent="Scroll/Body"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "ПУСТОЙ СЛОТ"

[node name="Power" type="Label" parent="Scroll/Body"]
layout_mode = 2

[node name="Help" type="Label" parent="Scroll/Body"]
layout_mode = 2
text = "Ручное сохранение обновляет текущий прогресс.
После сна сохраняется контрольная точка; доступны две предыдущие.
Откат заменяет текущий прогресс и удаляет будущие точки."

[node name="Continue" type="Button" parent="Scroll/Body"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
alignment = 0
text = "ПРОДОЛЖИТЬ ЭКСПЕДИЦИЮ"
script = ExtResource("button")

[node name="New" type="Button" parent="Scroll/Body"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
alignment = 0
text = "НОВАЯ ЭКСПЕДИЦИЯ В ЭТОМ СЛОТЕ"
script = ExtResource("button")

[node name="History" type="OptionButton" parent="Scroll/Body"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
size_flags_horizontal = 0

[node name="Rollback" type="Button" parent="Scroll/Body"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
alignment = 0
text = "ОТКАТИТЬСЯ К ТОЧКЕ"
script = ExtResource("button")

[node name="Delete" type="Button" parent="Scroll/Body"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
alignment = 0
text = "ОЧИСТИТЬ ЭТОТ СЛОТ"
script = ExtResource("button")

[node name="Status" type="Label" parent="."]
layout_mode = 2
