[resource]
script = ExtResource("script")
upgrades = Array[ExtResource("upgrade_type")]([ExtResource("pipette"), ExtResource("assistant"), ExtResource("centrifuge"), ExtResource("analyzer"), ExtResource("reactor"), ExtResource("microinjector"), ExtResource("culture_bank"), ExtResource("cryofarm"), ExtResource("laser_sampler"), ExtResource("gene_assembler"), ExtResource("bioprinter"), ExtResource("spectrometer"), ExtResource("neural_array"), ExtResource("quantum_lab"), ExtResource("nano_injector"), ExtResource("specimen_foundry"), ExtResource("biosphere"), ExtResource("phase_extractor"), ExtResource("orbital_relay"), ExtResource("polar_core"), ExtResource("molecular_forge"), ExtResource("xeno_culture"), ExtResource("singularity"), ExtResource("arctic_network"), ExtResource("genesis")])
