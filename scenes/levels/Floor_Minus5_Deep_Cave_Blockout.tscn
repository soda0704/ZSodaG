[node name="Floor_Minus5_Deep_Cave_Blockout" type="Node3D" unique_id=147903812]
editor_description = "Separately streamed Floor -5 cave module, loaded while the expedition winch cage descends from Floor -4. It is not a stop of the main base elevator."

[node name="Winch_Descent_Cave_Shell" type="Node3D" parent="." unique_id=938415762]
