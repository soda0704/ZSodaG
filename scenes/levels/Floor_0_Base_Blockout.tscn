[node name="Doors" type="Node3D" parent="." unique_id=1659585370]
editor_description = "Все двери нулевого уровня, их контроллер и временные блокирующие коллизии."

[node name="AutomaticDoors" type="Node" parent="Doors" unique_id=1013249623]
editor_description = "Отдельная сцена нулевого уровня базы. Содержит архитектуру, двери, временное освещение, сюжетный blockout и коллизии первого дня. Лифт и подземные уровни принадлежат сборочной сцене Base_Blockout_v03."
script = ExtResource("23_auto_doors")

