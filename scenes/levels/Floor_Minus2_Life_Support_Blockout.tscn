[node name="Floor_Minus2_Life_Support_Blockout" type="Node3D" unique_id=1525163854]
editor_description = "Floor -2 life-support infrastructure. One main level wraps around a recessed water-treatment reservoir, while an elevated inspection bridge and a flooded return channel introduce controlled verticality. The floor does not duplicate the Floor 0 generator or Floor -1 security functions."

