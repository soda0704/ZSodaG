[node name="Floor_Minus3_Biocontainment_Blockout" type="Node3D" unique_id=740111249]
editor_description = "Floor -3 staged rebuild. Stage 01 contains the elevator arrival. Stages 02-03 contain the clean suit room and failed treatment chamber. Stage 04 adds the ventilation bypass. Stage 05 adds the service observation room. Stage 06 adds the containment gallery. Stages 07-08 connect both access routes. Stages 09-10 add the contaminated-suit treatment and doffing rooms."

