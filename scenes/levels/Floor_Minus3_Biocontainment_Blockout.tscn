[node name="Floor_Minus3_Biocontainment_Blockout" type="Node3D" unique_id=1526355325]
editor_description = "Floor -3 biocontainment rebuild based on the approved laboratory references. Stages 01-03 form the compact elevator arrival, shared sanitation room, and glass corridor. Stage 04 adds the central laboratory, Stage 05 the cold capsule vault, Stage 06 the accessible two-level damaged containment block, and Stage 07 closes the route through the east monitoring and incident-analysis gallery."

