shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back;
uniform sampler2D depth_texture : hint_depth_texture, repeat_disable, filter_nearest;
uniform int mask_type=0;
uniform vec4 basin_bounds=vec4(0.0);
uniform float basin_phase=0.0;
varying vec2 world_uv;
varying vec3 water_normal;
float water_noise(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.0-2.0*f);vec4 h=fract(sin(vec4(dot(i,vec2(127.1,311.7)),dot(i+vec2(1,0),vec2(127.1,311.7)),dot(i+vec2(0,1),vec2(127.1,311.7)),dot(i+vec2(1,1),vec2(127.1,311.7))))*43758.5453);return mix(mix(h.x,h.y,f.x),mix(h.z,h.w,f.x),f.y);}
// Generated by tools/authoring/smooth_polar_stream.py. xy=center, z=water height, w=half width.
vec3 polar_stream_sample(vec2 p) {
 vec4 points[17]=vec4[](vec4(-215.0000000,-170.0000000,5.8800495,3.7595692),vec4(-211.7817663,-161.8750000,4.4572429,4.2750902),vec4(-208.7965729,-153.7500000,3.0344362,4.4430201),vec4(-206.2419819,-145.6250000,1.6116296,4.2139682),vec4(-204.2500000,-137.5000000,1.1334667,3.8106995),vec4(-202.8669819,-129.3750000,0.7340242,3.5272094),vec4(-202.0465729,-121.2500000,0.3345816,3.4772154),vec4(-201.6567663,-113.1250000,-0.6596080,3.5141282),vec4(-201.5000000,-105.0000000,-1.7619335,3.3904308),vec4(-201.3432337,-96.8750000,-2.8642589,3.0103738),vec4(-200.9534271,-88.7500000,-3.8033816,2.5463986),vec4(-200.1330181,-80.6250000,-3.8448890,2.3110386),vec4(-198.7500000,-72.5000000,-3.8863964,2.4943257),vec4(-196.7580181,-64.3750000,-3.9371246,2.9977973),vec4(-194.2034271,-56.2500000,-4.0985024,3.5122032),vec4(-191.2182337,-48.1250000,-4.2598802,3.7713357),vec4(-188.0000000,-40.0000000,-4.4212579,3.7595692));
 vec3 result=vec3(10000.0,0.0,0.0);
 for(int i=0;i<16;i++) {
  vec4 a=points[i];vec4 b=points[i+1];
  float t=clamp(dot(p-a.xy,b.xy-a.xy)/dot(b.xy-a.xy,b.xy-a.xy),0.0,1.0);
  float d=length(p-mix(a.xy,b.xy,t));
  if(d<result.x)result=vec3(d,mix(a.z,b.z,t),mix(a.w,b.w,t));
 }
 return result;
}

float stream_distance(vec2 p) { vec3 s=polar_stream_sample(p);return s.x-s.z;
}
void vertex() { world_uv=(MODEL_MATRIX*vec4(VERTEX,1.0)).xz;water_normal=normalize(MODEL_NORMAL_MATRIX*NORMAL); }
void fragment() {
	if(mask_type==1){vec2 q=(world_uv-basin_bounds.xy)/basin_bounds.zw;float a=atan(q.y,q.x);float r=length(q)*(1.0+.12*sin(a*3.0+basin_phase)+.07*sin(a*5.0));if(r>1.15)discard;}
	if(mask_type==2 && stream_distance(world_uv)>2.0)discard;
	float depth=texture(depth_texture,SCREEN_UV).r;
	vec4 scene=INV_PROJECTION_MATRIX*vec4(SCREEN_UV*2.0-1.0,depth,1.0);
	float thickness=max(0.0,-scene.z/scene.w+VERTEX.z);
	// Gradient of advected irregular ripples: no intersecting periodic sine bands.
	vec2 q=mat2(vec2(.82,.57),vec2(-.57,.82))*world_uv*2.8+vec2(TIME*.13,-TIME*.08);
	q+=vec2(sin(world_uv.y*.39),cos(world_uv.x*.31))*.24;
	vec2 n=vec2(water_noise(q+vec2(.035,0))-water_noise(q-vec2(.035,0)),water_noise(q+vec2(0,.035))-water_noise(q-vec2(0,.035)))*1.15;
	NORMAL=normalize((VIEW_MATRIX*vec4(normalize(water_normal+vec3(n.x,0.0,n.y)),0.0)).xyz);
	float fresnel=pow(1.0-clamp(dot(normalize(NORMAL),normalize(VIEW)),0.0,1.0),5.0);
	float shore=(1.0-smoothstep(.025,.18,thickness))*smoothstep(.55,.78,water_noise(world_uv*2.0));
	float absorption=1.0-exp(-thickness*.65);
	ALBEDO=mix(mix(vec3(.045,.115,.12),vec3(.012,.045,.052),absorption),vec3(.52,.61,.62),shore*.25);
	float minification=clamp(length(fwidth(world_uv))*.6,0.0,.16);
	ROUGHNESS=mix(.065+minification,.28,shore);SPECULAR=.25;
	// Shallow bed remains visible; opacity rises with optical depth and grazing angle.
	ALPHA=clamp(.07+absorption*.30+fresnel*.40+shore*.12,.07,.82);
}
