; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NorthernLab"
config/version="1.00"
run/main_scene="res://scenes/ui/startup.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/branding/releases/northernlab-logo-v1/northernlab-512.png"
config/windows_native_icon="res://assets/ui/branding/releases/northernlab-logo-v1/northernlab-windows.ico"

[autoload]

SteamNetwork="*res://scripts/network/steam/steam_network_service.gd"
CoopLobby="*res://scripts/network/lobby/coop_lobby_service.gd"
GameMenu="*res://scenes/ui/game_menu.tscn"
SteamInput="*res://scripts/input/steam_input_service.gd"
QuestJournal="*res://scenes/ui/quest_journal.tscn"
DeveloperConsole="*res://scenes/ui/developer_console.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://scenes/art/": "red",
"res://scenes/art/doors/": "red",
"res://scenes/art/elevator/": "red",
"res://scenes/levels/": "red",
"res://scenes/objects/elevator/": "red",
"res://scripts/gameplay/elevator/": "red"
}

[input]

weapon_attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)
, Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)
]
}
weapon_aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)
, Object(InputEventJoypadMotion,"axis":4,"axis_value":1.0)
]
}
replace_battery={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)
]
}
tester_feedback={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194339)
]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"unicode":1094)
]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"unicode":1099)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"unicode":1092)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"unicode":1074)
]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)
]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194326)
]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32,"unicode":32)
]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69,"unicode":1091)
]
}
flashlight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":70,"unicode":1072)
]
}
drop_item={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":71)
]
}
offer_item={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":3)
]
}
journal={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":74)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)
]
}

[layer_names]

3d_physics/layer_21="Player route blockers"

[network]

steam/app_id=480
steam/lobby_max_members=2
steam/lobby_tag="northern_lab_story_coop_v1"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/d3d12/max_resource_descriptors=131072
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_16_bits=false
reflections/reflection_atlas/reflection_size=32
reflections/reflection_atlas/reflection_count=16
environment/ssao/fadeout_from=30.0
environment/ssao/fadeout_to=150.0
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=3
