extends SceneTree
var failures := 0
var checks := 0
func _initialize() -> void:
	ProjectSettings.set_setting(ExpeditionSaveStore.ROOT_SETTING, "user://daily_save_slots_%d" % OS.get_process_id())
	ProjectSettings.set_setting(ExpeditionSaveStore.LEGACY_PATHS_SETTING, {})
	run.call_deferred()
func check(ok: bool, label: String) -> void:
	checks += 1
	print("PASS " if ok else "FAIL ", label)
	if not ok: failures += 1
func config(day: int, fuel: float) -> ConfigFile:
	var result := ConfigFile.new()
	result.set_value("save", "version", 1)
	result.set_value("base", "day_index", day)
	result.set_value("base", "fuel_liters", fuel)
	result.set_value("inventory", "checkpoint", {"players": {"steam:123": {"held_item": &"fuse"}}})
	return result
func run() -> void:
	for scope in ["solo", "coop"]:
		for number in range(1, 4):
			ExpeditionSaveStore.select(scope, number)
			check(ExpeditionSaveStore.clear(scope), "clear isolated %s/%d" % [scope, number])
			check(ExpeditionSaveStore.write(config(number, 30), scope, "start"), "initial morning %s/%d" % [scope, number])
	for scope in ["solo", "coop"]:
		for number in range(1, 4):
			ExpeditionSaveStore.select(scope, number)
			check(ExpeditionSaveStore.summary(scope).day_index == number, "independent expedition %s/%d" % [scope, number])
	ExpeditionSaveStore.select("coop", 2)
	check(ExpeditionSaveStore.write(config(2, 20), "coop", "manual"), "one manual save today")
	var current := ExpeditionSaveStore.read("coop")
	check(int(current.config.get_value("base", "manual_save_day")) == 2, "manual allowance is persisted")
	check(not ExpeditionSaveStore.write(config(2, 19), "coop", "manual"), "second manual save rejected")
	check(not ExpeditionSaveStore.write(config(2, 19), "coop", "progress"), "background world commits rejected")
	check(not ExpeditionSaveStore.write(config(2, 19), "coop", "event"), "story events cannot create extra checkpoints")
	check(ExpeditionSaveStore.read("coop").path == current.path, "rejected requests preserve exact save")
	var points := ExpeditionSaveStore.checkpoints("coop")
	check(points.size() == 3 and points[0].day_index == 2 and points[1].day_index == 2 and points[2].is_empty(), "manual and current morning occupy separate fixed entries")
	check(not ExpeditionSaveStore.write(config(2, 10), "coop", "sleep"), "repeated morning cannot overwrite start of day")
	check(ExpeditionSaveStore.rollback("coop", points[1].name), "load today's morning")
	check(ExpeditionSaveStore.checkpoints("coop")[0].is_empty(), "loading morning discards future manual branch")
	check(not ExpeditionSaveStore.write(config(2, 18), "coop", "manual"), "loading today's morning does not refund manual allowance")
	check(ExpeditionSaveStore.write(config(3, 16), "coop", "sleep"), "next morning recorded")
	points = ExpeditionSaveStore.checkpoints("coop")
	check(points[0].is_empty() and points[1].day_index == 3 and points[2].day_index == 2, "sleep expires manual and keeps exact consecutive mornings")
	check(ExpeditionSaveStore.write(config(3, 15), "coop", "manual"), "new day opens one manual save")
	check(ExpeditionSaveStore.write(config(4, 12), "coop", "sleep"), "third morning recorded")
	points = ExpeditionSaveStore.checkpoints("coop")
	check(points[0].is_empty() and points[1].day_index == 4 and points[2].day_index == 3, "older mornings leave selectable history")
	check(not ExpeditionSaveStore.rollback("coop", "../solo_1/name.cfg"), "reject path traversal")
	check(ExpeditionSaveStore.rollback("coop", points[2].name), "return to previous day")
	points = ExpeditionSaveStore.checkpoints("coop")
	check(ExpeditionSaveStore.summary("coop").day_index == 3 and points[1].day_index == 3 and points[2].is_empty(), "older branch cannot resurrect a morning outside the two offered entries")
	check(points[0].is_empty(), "manual from abandoned future is unavailable")
	var restored := ExpeditionSaveStore.read("coop")
	var damaged_branch := FileAccess.open(restored.path, FileAccess.WRITE)
	damaged_branch.store_string("broken restored branch")
	damaged_branch.close()
	check(ExpeditionSaveStore.summary("coop").day_index == 3, "recovery after rollback cannot return to the discarded future")
	check(ExpeditionSaveStore.write(config(3, 14), "coop", "manual"), "replayed previous day can use its morning allowance")
	current = ExpeditionSaveStore.read("coop")
	var file := FileAccess.open(current.path, FileAccess.WRITE)
	file.store_string("broken file")
	file.close()
	var recovered := ExpeditionSaveStore.read("coop")
	check(not recovered.is_empty() and recovered.recovered, "corrupt latest commit recovers verified record")
	var partial := FileAccess.open(ExpeditionSaveStore.directory("coop").path_join("commit_999999999999.cfg.tmp"), FileAccess.WRITE)
	partial.store_string("unfinished")
	partial.close()
	check(ExpeditionSaveStore.read("coop").path == recovered.path, "unfinished file is never loaded")
	var names := ExpeditionSaveStore._files("coop")
	var serial := int(names[0].trim_prefix("commit_").trim_suffix(".cfg")) + 1
	var blocked := ExpeditionSaveStore.directory("coop").path_join("commit_%012d.cfg.tmp" % serial)
	DirAccess.make_dir_absolute(ProjectSettings.globalize_path(blocked))
	check(not ExpeditionSaveStore.write(config(3, 13), "coop", "manual"), "failed write is reported")
	check(ExpeditionSaveStore.read("coop").path == recovered.path, "failure preserves checkpoint and allowance")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(blocked))
	check(ExpeditionSaveStore.write(config(3, 13), "coop", "manual"), "successful retry after failed write remains possible")
	check(ExpeditionSaveStore.clear("coop") and ExpeditionSaveStore.summary("coop").is_empty(), "clear removes current and history")
	ExpeditionSaveStore.select("coop", 1)
	check(ExpeditionSaveStore.summary("coop").day_index == 1, "other coop expedition preserved")
	ExpeditionSaveStore.select("solo", 2)
	check(ExpeditionSaveStore.summary("solo").day_index == 2, "solo expedition preserved")
	ExpeditionSaveStore.select("coop", 3)
	check(ExpeditionSaveStore.write(config(4, 10), "coop", "sleep") and ExpeditionSaveStore.write(config(4, 9), "coop", "manual"), "seed future branch for console rewind")
	var future := ExpeditionSaveStore.read("coop")
	names = ExpeditionSaveStore._files("coop")
	serial = int(names[0].trim_prefix("commit_").trim_suffix(".cfg")) + 1
	blocked = ExpeditionSaveStore.directory("coop").path_join("commit_%012d.cfg.tmp" % serial)
	DirAccess.make_dir_absolute(ProjectSettings.globalize_path(blocked))
	check(not ExpeditionSaveStore.write(config(3, 8), "coop", "sleep", true) and ExpeditionSaveStore.read("coop").path == future.path, "failed debug morning replacement preserves future branch")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(blocked))
	check(ExpeditionSaveStore.write(config(3, 8), "coop", "sleep", true), "explicit console replacement can rewind the saved day")
	check(ExpeditionSaveStore.summary("coop").day_index == 3 and ExpeditionSaveStore.checkpoints("coop")[0].is_empty(), "replacement exposes new morning without future manual save")
	check(not ExpeditionSaveStore.write(config(3, 7), "coop", "sleep"), "ordinary sleep still cannot replace the same morning")
	print("SAVE SLOT CHECKS ", checks, " FAILURES ", failures)
	quit(1 if failures else 0)
