extends "res://tools/tests/flamethrower_crafting_regression.gd"
func run() -> void:
 base=load("res://scenes/levels/Base_Blockout_v03.tscn").instantiate();root.add_child(base);current_scene=base
 await settle();root.get_node("GameMenu").force_close_menu()
 state=base.get_node("BaseGameplayController");state.set_process(false)
 player=get_first_node_in_group("local_player");player.set_physics_process(false);player.survival.set_physics_process(false)
 var console=root.get_node("DeveloperConsole")
 var before:Dictionary=RECIPE.available(player)
 console._execute_one("/flame assemble")
 check(not player.has_held_item(&"flamethrower") and RECIPE.available(player)==before,"missing components cannot assemble or mutate inventory")
 console._execute_one("/flame parts 2")
 for kind in RECIPE.requirements:check(int(RECIPE.available(player).get(kind,0))==int(before.get(kind,0))+2*int(RECIPE.requirements[kind]),"two full sets include "+String(kind))
 var count_before:int=base.get_node("FlamethrowerWorkbench").crafted_count()
 console._execute_one("/flame assemble")
 check(player.has_held_item(&"flamethrower") and not state.containment.get("cave_hives_found",false),"debug assembly works before discovery without setting story flags")
 check(base.get_node("FlamethrowerWorkbench").crafted_count()==count_before,"debug assembly leaves campaign crafting limit unchanged")
 var after:Dictionary=RECIPE.available(player)
 for kind in RECIPE.requirements:check(int(after.get(kind,0))==int(before.get(kind,0))+int(RECIPE.requirements[kind]),"assembly consumes exactly one "+String(kind))
 console._execute_one("/flame assemble")
 check(RECIPE.available(player)==after,"already held gun cannot consume another set")
 player.weapon.flame.fuel_liters=.5;player.weapon.flame.set_trigger_authoritative(true);player.weapon.flame.step_authoritative(.016)
 console._execute_one("/flame disassemble")
 check(not player.has_held_item(&"flamethrower") and not player.weapon.flame.emitting,"disassembly removes gun and stops its active jet")
 for kind in RECIPE.requirements:check(int(RECIPE.available(player).get(kind,0))==int(before.get(kind,0))+2*int(RECIPE.requirements[kind]),"disassembly restores one "+String(kind))
 var restored:Dictionary=RECIPE.available(player)
 console._execute_one("/flame disassemble")
 check(RECIPE.available(player)==restored,"repeated disassembly cannot duplicate components")
 for alias in ["large_cylinder","small_cylinder","cola_can","pipe_bundle","tape","hardware_box","pressure_gauge","valve"]:
  var kind:StringName=console.FlameCommands.part_type(alias);var owned:int=RECIPE.available(player).get(kind,0)
  console._execute_one("/flame give "+alias+" 2")
  check(int(RECIPE.available(player).get(kind,0))==owned+2,"individual inventory grant "+alias)
 var valid:Dictionary=RECIPE.available(player)
 for invalid in ["/flame parts 0","/flame parts 3","/flame give unknown","/flame give valve -1","/flame give valve 101","/flame assemble extra","/flame disassemble extra"]:
  console._execute_one(invalid);check(RECIPE.available(player)==valid,"invalid arguments leave inventory unchanged: "+invalid)
 console._execute_one("/weapon flamethrower")
 check(player.has_held_item(&"flamethrower") and is_equal_approx(player.weapon.flame.fuel_liters,player.weapon.flame.capacity_liters),"weapon command grants full flamethrower")
 console.target_point=player.global_position+Vector3(0,.2,-1)
 var spawn_kinds:Array=RECIPE.requirements.keys();spawn_kinds.append(&"flamethrower")
 for kind in spawn_kinds:
  var n:=get_nodes_in_group("world_items").size()
  console._execute_one("/item "+String(kind));await settle(2)
  check(get_nodes_in_group("world_items").size()==n+1,"native item spawn works in F6 for "+String(kind))
 var help:String=console._help_text()
 for command in console.FlameCommands.COMMANDS:check(command in help,"help includes "+command)
 console.entry.text="/flame ass";console.entry.caret_column=console.entry.text.length();console.complete_command()
 check(console.entry.text=="/flame assemble","Tab completes flame assembly")
 console.entry.text="/flame give";console.entry.caret_column=console.entry.text.length();console._refresh_suggestions()
 check("/flame give pipe_bundle" in console.get_node("Panel/Box/Commands").text,"filtered suggestions contain component commands")
 console.execute("/flame disassemble; /flame assemble")
 check(player.has_held_item(&"flamethrower"),"batch commands use the same disassembly and assembly handlers")
 print("FLAMETHROWER CONSOLE CHECKS ",checks," FAILURES ",failures)
 base.queue_free();await process_frame;quit(1 if failures else 0)
